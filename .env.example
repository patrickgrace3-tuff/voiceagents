# ─────────────────────────────────────────────────────────────
# Voice Agents test bench — environment variables
# Copy this file to `.env.local` and fill in your keys.
# `.env.local` is git-ignored; never commit real keys.
# ─────────────────────────────────────────────────────────────

# ── Bland.ai ──────────────────────────────────────────────────
# From https://app.bland.ai/ → Settings / API keys.
# Bland handles telephony itself, so this key alone is enough to
# place a real outbound test call.
BLAND_API_KEY=

# ── ElevenLabs ────────────────────────────────────────────────
# From https://elevenlabs.io/ → Profile → API key.
ELEVENLABS_API_KEY=

# ElevenLabs places outbound calls through a Twilio number that you
# link inside the ElevenLabs "Conversational AI / Agents" dashboard.
#
# 1. Create an agent in ElevenLabs and copy its Agent ID here.
#    (This app overrides the agent's prompt + first message per call,
#     so a single reusable "test" agent is fine. Make sure the agent's
#     Security settings allow overrides for "System prompt" and
#     "First message".)
ELEVENLABS_AGENT_ID=

# 2. Link a Twilio phone number to that agent and copy the
#    "Phone number ID" that ElevenLabs assigns it here.
ELEVENLABS_AGENT_PHONE_NUMBER_ID=
